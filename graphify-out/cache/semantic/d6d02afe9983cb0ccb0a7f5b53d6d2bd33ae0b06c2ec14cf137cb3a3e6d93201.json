{"nodes": [{"id": "lessons_11_interview_questions", "label": "Lesson 11 \u2014 Interview questions with defensible answers", "file_type": "document", "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lessons_11_interview_questions_concurrent_collections_dont_save_you", "label": "Concurrent collections protect their invariants, never yours", "file_type": "concept", "rationale": "ConcurrentDictionary is thread-safe and does not help: TryGetValue, decide, TryUpdate is still a race. The same argument applies to ConcurrentQueue as an aggregation strategy in lesson 07.", "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lessons_11_interview_questions_lock_vs_interlocked", "label": "lock vs Interlocked vs ReaderWriterLockSlim vs SemaphoreSlim cost", "file_type": "concept", "rationale": "Interlocked is a single atomic instruction over a single variable \u2014 cheaper and cannot deadlock; lock gives mutual exclusion over a region. Measured uncontended against a plain increment: Interlocked 13.7x, lock 54.6x, ReaderWriterLockSlim 59.2x, SemaphoreSlim 117x.", "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lessons_11_interview_questions_testing_a_race_with_a_gate", "label": "Testing a race by making the interleaving a parameter", "file_type": "rationale", "rationale": "Not by running it a lot and hoping: an injected gate holds every actor after its read until all have read, so the lost update reproduces 100% of the time. Invariant tests then run free and assert only what must be true under any interleaving \u2014 money conserved, balance never negative \u2014 never who won, because that is asserting the scheduler. The concession to make in an interview is that this is test code in production, mitigated by compiling it out behind a flag; Coyote explores interleavings systematically rather than sampling.", "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "lessons_11_interview_questions", "target": "lessons_11_interview_questions_concurrent_collections_dont_save_you", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "weight": 1.0}, {"source": "lessons_11_interview_questions", "target": "lessons_11_interview_questions_lock_vs_interlocked", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "weight": 1.0}, {"source": "lessons_11_interview_questions", "target": "lessons_11_interview_questions_testing_a_race_with_a_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "weight": 1.0}, {"source": "lessons_11_interview_questions", "target": "lessons_09_scaling", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "weight": 1.0}, {"source": "lessons_11_interview_questions", "target": "lessons_02_in_process_locking_semaphoreslim_over_lock", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "weight": 1.0}, {"source": "lessons_11_interview_questions", "target": "lessons_06_deadlocks_ordered_lock_acquisition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "weight": 1.0}, {"source": "lessons_11_interview_questions", "target": "lessons_03_optimistic_concurrency_xmin_concurrency_token", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "weight": 1.0}, {"source": "lessons_11_interview_questions", "target": "lessons_07_parallelism_cpu_bound_partition_then_merge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "weight": 1.0}, {"source": "lessons_11_interview_questions", "target": "lessons_10_benchmarking_vs_load_testing_benchmarking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/11-interview-questions.md", "source_location": null, "weight": 1.0}], "hyperedges": []}