{"nodes": [{"id": "rules_angular_ui", "label": "Angular UI rules", "file_type": "document", "source_file": ".claude/rules/angular-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_angular_ui_runsummarycalculator", "label": "RunSummaryCalculator", "file_type": "concept", "source_file": ".claude/rules/angular-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every verdict \u2014 who won, who lost silently, whether money was conserved \u2014 is computed server-side here and tested; the UI must not recompute or second-guess it."}, {"id": "rules_angular_ui_no_ngrx", "label": "Signals, no NgRx", "file_type": "concept", "source_file": ".claude/rules/angular-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The UI is a presentation surface; a state library would add ceremony that teaches nothing about concurrency."}, {"id": "rules_angular_ui_cors_dual_origin", "label": "CORS must allow localhost and 127.0.0.1", "file_type": "concept", "source_file": ".claude/rules/angular-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A browser treats them as different origins, so allowing one makes every call fail as if the API were down; a wildcard origin is impossible because SignalR needs AllowCredentials."}, {"id": "rules_angular_ui_signalr_groups_per_process", "label": "SignalR groups are per-process", "file_type": "concept", "source_file": ".claude/rules/angular-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Behind more than one replica this needs a Redis backplane; without one clients silently miss events, so the live feed is an accelerator and the REST timeline stays the source of truth."}], "edges": [{"sou