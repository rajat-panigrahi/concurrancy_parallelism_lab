{"nodes": [{"id": "adr_0015_local_postgres_over_testcontainers", "label": "ADR-0015 Local PostgreSQL + Respawn, not Testcontainers", "file_type": "document", "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0015_local_postgres_over_testcontainers_local_postgres", "label": "Local PostgreSQL + Respawn test database", "file_type": "rationale", "rationale": "Chosen only because there is no /var/run/docker.sock in this build environment \u2014 the docker CLI and dockerd exist but there is no daemon to talk to. Accepted costs: an external prerequisite (dotnet test fails with a connection error, mitigated by BANKLAB_TEST_DB), possible state leaks between runs, version drift, and limited parallelism against one shared database.", "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0015_local_postgres_over_testcontainers_testcontainers_rejected", "label": "Testcontainers (rejected on environment)", "file_type": "rationale", "rationale": "Hermetic, version-pinned and the better default where Docker exists \u2014 this ADR says it should be revisited there. It simply cannot run here: the suite would fail at fixture start.", "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0015_local_postgres_over_testcontainers_postgresfixture", "label": "PostgresFixture", "file_type": "concept", "rationale": "Owns the connection string (overridable via BANKLAB_TEST_DB) and applies migrations once per run in InitializeAsync; shared through an xUnit collection so migrations run once rather than per test class.", "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0015_local_postgres_over_testcontainers_isolation_levers", "label": "Three isolation levers for shared-database tests", "file_type": "concept", "rationale": "Unique data per test (what this repo does), a transaction rolled back per test, or a full Respawn reset. The middle one is the trap: it is the standard trick and silently does not work for code that manages its own transactions \u2014 exactly the pessimistic slice.", "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "adr_0015_local_postgres_over_testcontainers", "target": "adr_0015_local_postgres_over_testcontainers_local_postgres", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md", "source_location": null, "weight": 1.0}, {"source": "adr_0015_local_postgres_over_testcontainers_local_postgres", "target": "adr_0015_local_postgres_over_testcontainers_testcontainers_rejected", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md", "source_location": null, "weight": 1.0}, {"source": "adr_0015_local_postgres_over_testcontainers_local_postgres", "target": "adr_0015_local_postgres_over_testcontainers_postgresfixture", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md", "source_location": null, "weight": 1.0}, {"source": "adr_0015_local_postgres_over_testcontainers_local_postgres", "target": "adr_0015_local_postgres_over_testcontainers_isolation_levers", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md", "source_location": null, "weight": 1.0}, {"source": "adr_0015_local_postgres_over_testcontainers", "target": "adr_0004_hybrid_persistence", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md", "source_location": null, "weight": 1.0}, {"source": "adr_0015_local_postgres_over_testcontainers", "target": "adr_0004_hybrid_persistence_ef_inmemory_provider", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md", "source_location": null, "weight": 1.0}, {"source": "adr_0015_local_postgres_over_testcontainers_postgresfixture", "target": "adr_0016_three_tier_test_strategy_integration_tier", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "environment_constraints_shaped_decisions", "label": "Blocked CDN, no Docker daemon, no proxy egress \u2014 constraints that decided three ADRs", "nodes": ["adr_0003_target_dotnet_8_lts_net8_target", "adr_0005_postgresql_over_sqlserver_sqlite_sqlserver_rejected", "adr_0010_three_perf_tools_k6", "adr_0014_compose_not_kubernetes_compose_replicas", "adr_0015_local_postgres_over_testcontainers_local_postgres"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/architecture/adr/0015-local-postgres-over-testcontainers.md"}]}