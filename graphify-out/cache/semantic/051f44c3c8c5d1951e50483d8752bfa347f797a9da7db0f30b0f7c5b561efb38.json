{"nodes": [{"id": "lessons_04_pessimistic_concurrency", "label": "Lesson 04 \u2014 Pessimistic concurrency", "file_type": "document", "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lessons_04_pessimistic_concurrency_select_for_update", "label": "SELECT *, xmin ... FOR UPDATE row lock", "file_type": "concept", "rationale": "Three things make it correct: it is inside a transaction (a row lock lives until the transaction ends), the read is inside the lock, and the lock is held until commit so no check-to-write window exists. xmin must be named explicitly because a system column is not returned by SELECT *. SQL Server equivalent is WITH (UPDLOCK, ROWLOCK).", "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lessons_04_pessimistic_concurrency_pays_in_waiting", "label": "Pessimistic concurrency pays in waiting", "file_type": "concept", "rationale": "Measured on identical input: 5 attempts, 0 conflicts, 244.1 ms waited versus optimistic's 9 attempts, 4 conflicts, 0.0 ms. Conflicts are prevented rather than detected, so nothing is redone \u2014 but total wall time is the sum of the queue, not the max.", "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lessons_04_pessimistic_concurrency_connection_pool_exhaustion", "label": "Connection pool exhaustion from blocked transactions", "file_type": "concept", "rationale": "Every blocked transaction holds a connection. Enough waiters and unrelated endpoints start failing \u2014 one of the most common causes of 'the database is down' incidents that turn out not to be the database's fault. Related failure modes: long transactions and SQL Server lock escalation.", "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lessons_04_pessimistic_concurrency_serializable_isolation", "label": "Serializable isolation is optimistic in character", "file_type": "rationale", "rationale": "SELECT ... FOR UPDATE is explicit locking, mostly orthogonal to isolation level (Postgres defaults to Read Committed). Serializable would also prevent the lost update, but by aborting transactions with a serialization failure \u2014 so you need a retry loop again, and it serialises more than intended.", "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "lessons_04_pessimistic_concurrency", "target": "lessons_04_pessimistic_concurrency_select_for_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "weight": 1.0}, {"source": "lessons_04_pessimistic_concurrency", "target": "lessons_04_pessimistic_concurrency_pays_in_waiting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "weight": 1.0}, {"source": "lessons_04_pessimistic_concurrency", "target": "lessons_04_pessimistic_concurrency_connection_pool_exhaustion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "weight": 1.0}, {"source": "lessons_04_pessimistic_concurrency", "target": "lessons_04_pessimistic_concurrency_serializable_isolation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "weight": 1.0}, {"source": "lessons_04_pessimistic_concurrency_select_for_update", "target": "lessons_03_optimistic_concurrency_xmin_concurrency_token", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "weight": 1.0}, {"source": "lessons_04_pessimistic_concurrency", "target": "lessons_06_deadlocks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "weight": 1.0}, {"source": "lessons_04_pessimistic_concurrency", "target": "lessons_02_in_process_locking_never_hold_a_lock_across_io", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "weight": 1.0}, {"source": "lessons_04_pessimistic_concurrency_serializable_isolation", "target": "lessons_03_optimistic_concurrency_bounded_retry_loop", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/lessons/04-pessimistic-concurrency.md", "source_location": null, "weight": 1.0}], "hyperedges": []}