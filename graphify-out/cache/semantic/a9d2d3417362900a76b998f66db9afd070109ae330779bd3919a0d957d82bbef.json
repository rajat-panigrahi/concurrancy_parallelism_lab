{"nodes": [{"id": "architecture_system_overview", "label": "System overview", "file_type": "document", "source_file": "docs/architecture/system-overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_system_overview_where_state_lives", "label": "Where mutable state lives", "file_type": "rationale", "rationale": "Almost every concurrency question in the repo reduces to this. Red boxes (InMemoryAccountStore, SemaphoreSlim per account) are per process; green (PostgreSQL) is shared by every instance. Scale to three instances and the red boxes are duplicated three times \u2014 three separate stores, three sets of locks, coordinating nothing.", "source_file": "docs/architecture/system-overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_system_overview_three_replica_topology", "label": "Three replicas behind nginx topology", "file_type": "concept", "rationale": "Nothing about the code changed between the one-instance and three-replica diagrams. What changed is that `lock` now guards one third of the traffic, which is the same as guarding none of it. The database slices are unaffected because their coordination point was never in process memory.", "source_file": "docs/architecture/system-overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_system_overview_four_strategies_sequence", "label": "A contended withdrawal, four ways", "file_type": "concept", "rationale": "Naive loses an update because the gap between read and write leaves a stale value; the in-process lock is correct only because both actors share one semaphore object in one process; optimistic has nobody wait but the loser redo work; pessimistic has nobody waste work but the loser wait, and is a throughput disaster if the transaction is long.", "source_file": "docs/architecture/system-overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_system_overview_request_path_through_slice", "label": "Request path through a slice", "file_type": "concept", "rationale": "HTTP \u2192 Endpoint.cs \u2192 Handler.cs \u2192 IInterleaveGate / store or DbContext / IContentionRecorder \u2192 SignalR hub \u2192 Angular timeline. Two files per slice, no dispatcher and no pipeline in between.", "source_file": "docs/architecture/system-overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "architecture_system_overview", "target": "architecture_system_overview_where_state_lives", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/system-overview.md", "source_location": null, "weight": 1.0}, {"source": "architecture_system_overview_where_state_lives", "target": "architecture_system_overview_three_replica_topology", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/system-overview.md", "source_location": null, "weight": 1.0}, {"source": "architecture_system_overview_where_state_lives", "target": "adr_0004_hybrid_persistence_inmemoryaccountstore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/system-overview.md", "source_location": null, "weight": 1.0}, {"source": "architecture_system_overview_request_path_through_slice", "target": "adr_0008_interleave_gate_in_production_code_iinterleavegate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/system-overview.md", "source_location": null, "weight": 1.0}, {"source": "architecture_system_overview_request_path_through_slice", "target": "adr_0009_signalr_for_live_timeline_content