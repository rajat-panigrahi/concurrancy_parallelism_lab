 replicas", "nodes": ["adr_0004_hybrid_persistence_inmemoryaccountstore", "adr_0009_signalr_for_live_timeline_contentionhub", "adr_0012_postgres_advisory_locks_inprocessaccountlock", "adr_0013_in_memory_ring_buffer_bounded_buffer", "architecture_system_overview_three_replica_topology"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/architecture/system-overview.md"}]}