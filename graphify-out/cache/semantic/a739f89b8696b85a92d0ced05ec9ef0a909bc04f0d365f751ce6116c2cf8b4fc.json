{"nodes": [{"id": "rules_concurrency_slices", "label": "Concurrency slice rules", "file_type": "document", "source_file": ".claude/rules/concurrency-slices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_concurrency_slices_iwithdrawstrategy", "label": "IWithdrawStrategy", "file_type": "concept", "source_file": ".claude/rules/concurrency-slices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be registered as a singleton in Program.cs \u2014 an unregistered strategy compiles and silently never appears in /api/lab/strategies."}, {"id": "rules_concurrency_slices_icontentionrecorder", "label": "IContentionRecorder", "file_type": "concept", "source_file": ".claude/rules/concurrency-slices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Called from inside the code under observation, so it must never block, do I/O or throw; use Interlocked for counters and push SignalR fan-out to the background ContentionBroadcaster."}, {"id": "rules_concurrency_slices_contentionbroadcaster", "label": "ContentionBroadcaster", "file_type": "concept", "source_file": ".claude/rules/concurrency-slices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_concurrency_slices_iaccountlock", "label": "IAccountLock", "file_type": "concept", "source_file": ".claude/rules/concurrency-slices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two implementations behind one interface; swapping the DI registration is the entire scale-out lesson."}, {"id": "rules_concurrency_slices_inprocessaccountlock", "label": "InProcessAccountLock", "file_type": "concept", "source_file": ".claude/rules/concurrency-slices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Correct on one instance only \u2014 process memory is not shared between replicas."}, {"id": "rules_concurrency_slices_postgresadvisoryaccountlock", "label": "PostgresAdvisoryAccountLock", "file_type": "concept", "source_file": ".claude/rules/concurrency-slices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Survives any number of instances because the coordination point is the database."}, {"id": "rules_concurrency_slices_interleavecheckpoints", "label": "InterleaveCheckpoints (BeforeAcquire / AfterRead)", "file_type": "concept", "source_file": ".claude/rules/concurrency-slices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_concurrency_slices_gate_placement", "label": "Gate placement rule", "file_type": "concept", "source_file": ".claude/rules/concurrency-slices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lock-taking handlers gate at BeforeAcquire, lock-free handlers at AfterRead; the 5-second gate cap is a safety net, not a licence to gate in the wrong place."}, {"id": "rules_concurrency_slices_semaphoreslim_over_lock", "label": "SemaphoreSlim, never lock, around await", "file_type": "concept", "source_file": ".claude/rules/concurrency-slices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "rules_concurrency_slices", "target": "rules_concurrency_slices_iwithdrawstrategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/concurrency-slices.md", "source_location": null, "weight": 1.0}, {"source": "rules_concurrency_slices", "target": "rules_concurrency_slices_icontentionrecorder", "relation": "references", "confidence":