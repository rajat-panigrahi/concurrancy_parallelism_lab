{"nodes": [{"id": "rules_testing", "label": "Testing rules", "file_type": "document", "source_file": ".claude/rules/testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_testing_shouldly", "label": "Shouldly assertions", "file_type": "concept", "source_file": ".claude/rules/testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_testing_no_unforced_ordering", "label": "Never assert an ordering you did not force", "file_type": "concept", "source_file": ".claude/rules/testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asserting a specific actor won is asserting the scheduler's mood and will fail eventually; assert only what holds under every interleaving."}, {"id": "rules_testing_relative_timing_assertions", "label": "Relative-only timing assertions", "file_type": "concept", "source_file": ".claude/rules/testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Absolute upper bounds flake on a loaded machine; absolute lower bounds derived from the work are fine. Two performance-ratio assertions were deleted in M5 after failing under CPU load \u2014 ratios belong in BenchmarkDotNet, which has warmup and error bars."}, {"id": "rules_testing_timingsensitivecollection", "label": "TimingSensitiveCollection", "file_type": "concept", "source_file": ".claude/rules/testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disables parallelisation so an elapsed-time test is not competing with three others for the same cores."}, {"id": "rules_testing_three_tiers", "label": "Three-tier test strategy", "file_type": "concept", "source_file": ".claude/rules/testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic tests may assert a specific forced interleaving; invariant tests assert only what holds under every interleaving; integration tests against real PostgreSQL are the only place concurrency tokens and row locks are real."}, {"id": "rules_testing_invariantsuitehasteethtests", "label": "InvariantSuiteHasTeethTests", "file_type": "concept", "source_file": ".claude/rules/testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Points the invariants at the naive handler and requires them to fail; if they start passing the suite has stopped applying pressure."}, {"id": "rules_testing_no_ef_inmemory_provider", "label": "No EF Core in-memory provider for integration tests", "file_type": "concept", "source_file": ".claude/rules/testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It implements neither concurrency tokens nor row locks, so tests would pass against a system that is still broken."}], "edges": [{"source": "rules_testing", "target": "rules_testing_shouldly", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/testing.md", "source_location": null, "weight": 1.0}, {"source": "rules_testing", "target": "rules_testing_no_unforced_ordering", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/testing.md", "source_location": null, "weight": 1.0}, {"source": "rules_testing", "target": "rules_testing_relative_timing_assertions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/testing.md", "source_location": null, "weight": 1.0}, {"source": "rules_testing", "target": "rules_testing_timingsensitivecollection", "relation": "references", "confidence": "EXTRACTED", "confidence_sc