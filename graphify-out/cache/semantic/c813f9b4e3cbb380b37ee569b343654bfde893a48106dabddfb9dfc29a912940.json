{"nodes": [{"id": "adr_0009_signalr_for_live_timeline", "label": "ADR-0009 SignalR for the live timeline", "file_type": "document", "source_file": "docs/architecture/adr/0009-signalr-for-live-timeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0009_signalr_for_live_timeline_signalr", "label": "SignalR live contention feed", "file_type": "rationale", "rationale": "Chosen over SSE because SignalR's group model gives per-run fan-out for free and because SignalR is itself a standard .NET interview topic. Polling the finished run is kept as a fallback and for replay, but loses the property that matters: seeing events arrive while contention is happening.", "source_file": "docs/architecture/adr/0009-signalr-for-live-timeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0009_signalr_for_live_timeline_contentionhub", "label": "ContentionHub (WatchRun / StopWatchingRun)", "file_type": "concept", "rationale": "Clients join group run-{id}. Groups live in the process, so with multiple replicas a client on instance 2 misses events published on instance 1 \u2014 the same bug as the in-process lock, in a different costume.", "source_file": "docs/architecture/adr/0009-signalr-for-live-timeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0009_signalr_for_live_timeline_contentionbroadcaster", "label": "ContentionBroadcaster BackgroundService", "file_type": "concept", "rationale": "Drains the recorder's channel so a slow or broken client can never slow down a bank withdrawal; broadcast failures are logged and swallowed. Pushing inline from Record() would put a network call inside the critical section being measured.", "source_file": "docs/architecture/adr/0009-signalr-for-live-timeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0009_signalr_for_live_timeline_sse_rejected", "label": "Server-Sent Events (rejected, close call)", "file_type": "rationale", "rationale": "Arguably the better engineering choice in isolation \u2014 the feed is one-directional and EventSource needs no client dependency \u2014 but it would need hand-rolled per-run subscriber bookkeeping, and SignalR is the thing interviews ask about.", "source_file": "docs/architecture/adr/0009-signalr-for-live-timeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0009_signalr_for_live_timeline_backplane", "label": "Redis backplane and sticky sessions", "file_type": "concept", "rationale": "Required once there is more than one replica, because SignalR groups are per-process and WebSocket connections are long-lived so the load balancer must pin a client to one instance.", "source_file": "docs/architecture/adr/0009-signalr-for-live-timeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "adr_0009_signalr_for_live_timeline", "target": "adr_0009_signalr_for_live_timeline_signalr", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/adr/0009-signalr-for-live-timeline.md", "source_location": null, "weight": 1.0}, {"source": "adr_0009_signalr_for_live_timeline_signalr", "target": "adr_0009_signalr_for_live_timeline_contentionhub", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/adr/0009-signalr-for-live-timeline.md", "source_location": null, "weight": 1.0}, {"source": "adr_0009_signalr_for_live_timeline_contentionbroadcaster", "target": "adr_0009_signalr_for_live_timeline_contentionhub", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/adr/0009-si