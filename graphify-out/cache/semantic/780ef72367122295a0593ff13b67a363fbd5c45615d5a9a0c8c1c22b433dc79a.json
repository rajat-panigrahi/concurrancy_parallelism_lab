{"nodes": [{"id": "claude", "label": "CLAUDE.md project instructions", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_naivewithdrawhandler", "label": "NaiveWithdrawHandler (deliberately lossy)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Performs an unguarded read-decide-write and is supposed to lose updates; tests assert that it does. Fixing it removes the lesson."}, {"id": "claude_inmemoryaccountstore", "label": "InMemoryAccountStore (unsafe singleton on purpose)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately not thread-safe at the account level and registered as a singleton. Adding a lock or scoping it per-request silently deletes the bug the repo is built to demonstrate."}, {"id": "claude_scaleendpoints", "label": "ScaleEndpoints sync-over-async endpoint", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calls .GetAwaiter().GetResult() on purpose to demonstrate thread-pool starvation under load."}, {"id": "claude_intereststrategies", "label": "InterestStrategies ParallelWithLock / ParallelWithConcurrentQueue", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slow on purpose \u2014 the 'I parallelised it and it got slower' result."}, {"id": "claude_do_not_fix", "label": "Do-not-fix deliberate defects", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_warnings_as_errors", "label": "Warnings are errors (CS9113)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TreatWarningsAsErrors in Directory.Build.props turns an unread primary-constructor parameter into a build failure; use the parameter or drop it."}, {"id": "claude_no_commercial_dependencies", "label": "No commercially-licensed dependencies", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MediatR, FluentAssertions and NBomber rejected on licence grounds so a reader can use the same approach at work; Shouldly and an in-repo load harness replace them."}, {"id": "claude_vertical_slice", "label": "Vertical slice convention", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_gate_before_acquiring_lock", "label": "Gate before acquiring a lock", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gating inside a critical section deadlocks: the lock holder waits at a barrier for actors who cannot enter until it releases."}, {"id": "claude_first_attempt_joins_barrier", "label": "Only the first retry attempt joins the barrier", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrying actors that re-join a barrier stall the run until the 5s timeout, because actors that already finished never arrive."}, {"id": "claude_fresh_dbcontext_per_retry", "label": "Fresh DbContext per retry attempt", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reusing one keeps the stale entity in the change tracker, so the retry re-sends the same doomed UPDATE forever."}, {"id": "claude_xmin_system_column", "label": "xmin is a PostgreSQL system column", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not included in SELECT *, so raw SQL must say SELECT *, xmin FROM \"Accounts\" or EF fails to materialise the entity."}, {"id": "claude_dbcontext_not_thread_safe", "label": "DbContext is not thread-safe", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrent actors each need their own context from IDbContextFactory<BankDbContext>."}, {"id": "claude_money_is_decimal", "label": "Money is decimal, cents are long", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_no_docker_daemon", "label": "No Docker daemon in this environment", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 3-replica demo has only ever been `docker compose config`-validated; claiming it was run would be false."}], "edges": [{"source": "claude_gate_before_acquiring_lock", "target": "rules_concurrency_slices_gate_placement", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude", "target": "claude_do_not_fix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight